package com.km_foundation.yemak_servis.dao;

import org.springframework.beans.factory.annotation.Autowired; 
import org.springframework.stereotype.Repository;

import com.km_foundation.yemak_servis.dto.Branch;
import com.km_foundation.yemak_servis.dto.User;
import com.km_foundation.yemak_servis.repo.FoodRepository;

@Repository
public class Dao {
	
	@Autowired
	FoodRepository repo;
	
	public User save(User user)
	{
		return repo.save(user);
	}
	
	public User getByEmail(int id)
	{
		return repo.findById(id).get();
	}
	public User updateBranch(int id)
	{
		return repo.findById(id).get();
	}
}
