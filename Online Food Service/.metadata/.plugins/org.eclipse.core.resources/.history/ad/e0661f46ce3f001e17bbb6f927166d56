package com.km_foundation.yemak_servis.service;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired; 
import org.springframework.stereotype.Service;

import com.km_foundation.yemak_servis.dao.Dao;
import com.km_foundation.yemak_servis.dto.Branch;
import com.km_foundation.yemak_servis.dto.FoodOrder;
import com.km_foundation.yemak_servis.dto.User;

@Service
public class FService {

	@Autowired
	Dao dao;

	public User save(User user)
	{
		return dao.save(user);
	}
	public Branch saveBranch(Branch branch)
	{
				return dao.saveBranch(branch);;
	}
	
	public User getByEmail(int id)
	{
		return dao.getByEmail(id);
	}

	public User findByEmail(String email,String password)
	{
		
		User u=dao.findByEmail(email);
		if(u!=null)
		{
			if(u.getEmail().equals(email) && u.getPassword().equals(password) && u.getRole().equals("Admin"))
			{
				return u;
			}
			else
				return null;
		}
		else 
			return null;
	}
	
	
	
}
