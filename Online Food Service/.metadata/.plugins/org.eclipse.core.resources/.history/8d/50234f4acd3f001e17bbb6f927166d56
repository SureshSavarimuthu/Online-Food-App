@Repository
public class Dao {
	
	@Autowired
	UserFoodRepository userFoodRepository;
	
	BranchFoodRepository 
	
	
	public User save(User user)
	{
		return userFoodRepository.save(user);
	}
	
	public User getByEmail(int id)
	{
		return userFoodRepository.findById(id).get();
	}
	public User updateBranch(int id)
	{
		return userFoodRepository.findById(id).get();
	}
	
	public User findByEmail(String email)
	{
		return userFoodRepository.findByEmail(email);
	}
	
