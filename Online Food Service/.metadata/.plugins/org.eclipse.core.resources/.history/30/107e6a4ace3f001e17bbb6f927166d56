package com.km_foundation.yemak_servis.controller;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import com.km_foundation.yemak_servis.dto.Branch;
import com.km_foundation.yemak_servis.dto.User;
import com.km_foundation.yemak_servis.service.FService;

@RestController
public class Controller {
	
	@Autowired
	FService foodService;

	@PostMapping("save")
	public User save(@RequestBody User user)
	{
		return foodService.save(user);
	}
	@GetMapping("getById")
	public User getById(int id)
	{
		return foodService.getByEmail(id);
	}
	@GetMapping("getEmail")
	public User findByEmail(@RequestParam String email,@RequestParam String password)
	{
		return foodService.findByEmail(email, password);
	}

	@PostMapping("saveBranch")
	public Branch saveBranch(Branch branch)
	{
		return foodService.saveBranch1(branch);
	}
	
	
}
 